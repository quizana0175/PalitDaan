# ============================================================
# PalitDaan Green — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ============================================================

# Supabase Project URL (from: Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key (from: Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: set to 'true' to force localStorage mode even when Supabase is configured
# VITE_USE_LOCAL_STORAGE=false
